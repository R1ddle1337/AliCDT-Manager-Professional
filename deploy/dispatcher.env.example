# Copy to a root-only file (for example /etc/cdt-dispatcher.env) and replace
# placeholders. Never commit the resulting file.
CDT_DISPATCH_CONTROLLER_URL=https://panel.example.com
CDT_DISPATCH_POOL_ID=pool_xxxxxxxxx
CDT_DISPATCH_TOKEN=replace-with-a-random-32-byte-token
CDT_DISPATCH_RELEASE_SOURCE=controller
CDT_DISPATCH_PUBLIC_PORT=443
CDT_DISPATCH_HEALTH_PORT=9091
CDT_DISPATCH_NETWORK=tcp+udp
CDT_DISPATCH_POLL_INTERVAL=15s
CDT_DISPATCH_STALE_AFTER=2m
CDT_DISPATCH_REQUEST_TIMEOUT=10s
CDT_DISPATCH_MAX_SNAPSHOT_AGE=2m
