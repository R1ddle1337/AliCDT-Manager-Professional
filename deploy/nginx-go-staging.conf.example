# Add this in the nginx http {} block once.
limit_req_zone $binary_remote_addr zone=alicdt_go_api:10m rate=30r/s;

# Add these locations to the existing cdt.7b.tn HTTPS server block.
# The current location / continues to serve the Python production panel.
location = /agent/install.sh {
    proxy_pass http://127.0.0.1:18010;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
}

location ^~ /api/v2/ {
    limit_req zone=alicdt_go_api burst=60 nodelay;
    client_max_body_size 1m;
    proxy_pass http://127.0.0.1:18010;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    proxy_send_timeout 15s;
}
