FROM node:24-alpine AS frontend-build

WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM golang:1.24-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/alicdt-controller ./cmd/controller

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/alicdt-controller /usr/local/bin/alicdt-controller
COPY --from=frontend-build /src/frontend/dist /app/frontend
COPY scripts/install-agent.sh /app/assets/install-agent.sh
VOLUME ["/app/data"]
EXPOSE 8080
ENV CDT_FRONTEND_DIR=/app/frontend
ENV CDT_AGENT_INSTALLER=/app/assets/install-agent.sh
ENTRYPOINT ["/usr/local/bin/alicdt-controller"]
