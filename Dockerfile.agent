FROM golang:1.25.13-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/cdt-relay-agent ./cmd/relay-agent

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/cdt-relay-agent /usr/local/bin/cdt-relay-agent
VOLUME ["/var/lib/cdt-relay"]
ENTRYPOINT ["/usr/local/bin/cdt-relay-agent"]
